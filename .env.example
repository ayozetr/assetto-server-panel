# Web server
HOST=0.0.0.0       # 0.0.0.0 = all interfaces, 127.0.0.1 = localhost only
PORT=3000

# AC Server — adjust to your installation paths
AC_SERVER_LOG=/home/YOUR_USER/ac_server/server_output.log
AC_SERVER_RESULTS=/home/YOUR_USER/ac_server/results
AC_CFG_DIR=/srv/assetto/cfg
AC_CONTENT_DIR=/srv/assetto/content
AC_HTTP_PORT=8081       # AC server HTTP API port (used to detect if server is running)
