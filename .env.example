# =============================================================================
# Assetto Server Panel — environment variables
# =============================================================================
# Copy this file to `.env` and adjust ONLY the AC_* paths to point at your
# acServer installation. Everything else has a sensible default — leave the
# lines commented unless you actually need to change them.
#
# First-run guide:
#   1. cp .env.example .env
#   2. Edit AC_CONTENT_DIR + AC_CFG_DIR + AC_SERVER_BIN + AC_SERVER_DIR
#      (the panel will auto-detect the rest from those four).
#   3. npm install && npm start  (or: docker compose up -d)
#   4. Open http://localhost:3000 — default creds Admin / Admin1234! force
#      a password change on first login.
# =============================================================================


# ── REQUIRED: tell the panel where your acServer install lives ───────────────
# Two common layouts:
#   (a) everything under the user's home:  /home/<user>/ac_server/{cfg,content,...}
#   (b) shared system path:                /srv/assetto/{cfg,content} + binary in $HOME
# Pick whichever matches your install. The four AC_* below are the only ones
# the panel cannot infer; AC_SERVER_RESULTS, blacklist/whitelist files and the
# AC log file all derive from AC_SERVER_DIR or AC_CFG_DIR by default.
AC_CONTENT_DIR=/srv/assetto/content
AC_CFG_DIR=/srv/assetto/cfg
AC_SERVER_BIN=/home/YOUR_USER/ac_server/acServer
AC_SERVER_DIR=/home/YOUR_USER/ac_server


# ── Web server ───────────────────────────────────────────────────────────────
# HOST=127.0.0.1 is the safe default — the panel is reachable only from the
# same machine. Put a reverse proxy / Cloudflare Tunnel in front for remote
# access. Switch to 0.0.0.0 ONLY if you want raw LAN access AND your firewall
# blocks port 3000 from the internet.
HOST=127.0.0.1
PORT=3000


# ── OPTIONAL: every line below has a working default ─────────────────────────

# acServer HTTP API port (must match HTTP_PORT in server_cfg.ini). The panel
# polls /INFO here to detect whether acServer is running.
# AC_HTTP_PORT=8081

# Derived from AC_SERVER_DIR/AC_CFG_DIR by default — uncomment only to override:
# AC_SERVER_RESULTS=/home/YOUR_USER/ac_server/results
# AC_SERVER_LOG=./logs/ac_server.log
# AC_BLACKLIST_FILE=/home/YOUR_USER/ac_server/blacklist.txt
# AC_WHITELIST_FILE=/srv/assetto/cfg/whitelist.txt

# Where the panel keeps its SQLite database. Default: assetto.db in the
# project root. Move it to a persistent volume in containers.
# DB_PATH=/data/assetto.db

# Force the public IP shown in the "Connect" button. Skip auto-detection
# (which calls api.ipify.org once per hour). Useful behind NAT / a tunnel.
# PUBLIC_IP=1.2.3.4


# ── Reverse proxy / Cloudflare Tunnel ────────────────────────────────────────
# Set TRUST_PROXY=1 ONLY when the panel sits behind a reverse proxy that
# terminates client connections (Cloudflare Tunnel, nginx, Caddy, Traefik,
# Tailscale Funnel). When set, the panel honours CF-Connecting-IP /
# X-Forwarded-For so per-IP rate limits and the audit log see the real client.
#
# Spoofing is blocked by a TRUST_PROXY_FROM allowlist: forwarded-IP headers
# are only honoured when the socket-level peer is in the allowlist. Defaults
# to Cloudflare's published edge ranges + loopback; override with a custom
# CIDR list when behind a different proxy.
# TRUST_PROXY=1
# TRUST_PROXY_FROM=10.0.0.0/8,127.0.0.0/8

# Legacy static token for headless scripts (start/stop/restart endpoints).
# Session cookies are preferred — only set this when a script can't log in.
# ADMIN_TOKEN=change-me-to-a-random-secret


# ── Retention ────────────────────────────────────────────────────────────────
# How many days of audit_log rows to keep. A daily sweeper drops older rows
# and inserts a boundary row carrying the count + tail hash so retention is
# visible in the hash chain. Default 365.
# AUDIT_RETENTION_DAYS=365

# How many timestamped server_cfg.ini.<datetime>.bak copies to keep. The
# plain server_cfg.ini.bak (last save) is always kept on top. Default 10.
# CFG_BACKUPS_KEEP=10


# ── Scheduled DB backups (opt-in) ────────────────────────────────────────────
# Every BACKUP_INTERVAL_HOURS the panel takes a consistent VACUUM INTO
# snapshot of the SQLite DB and rotates retention to BACKUP_KEEP files.
# 0 = disabled (default). The manual /api/admin/backup endpoint always works.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_DIR=/var/lib/assetto-panel/backups    # default: ./backups next to DB


# ── Things you do NOT need to set ────────────────────────────────────────────
# UDP plugin (live lap capture): the panel writes UDP_PLUGIN_LOCAL_PORT and
# UDP_PLUGIN_ADDRESS into server_cfg.ini on the first session apply, picks a
# default port pair (12000 / 127.0.0.1:12001), restarts acServer to pick it up
# and starts streaming events. Zero manual config.
