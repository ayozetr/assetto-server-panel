# Dependencies
node_modules/

# Build output (generated by `npm run build` / npm prestart)
dist/

# Environment — never commit real credentials
.env

# Logs
*.log
*.txt
logs/

# Database
*.db
*.db-shm
*.db-wal

# Artefacts
*.zip
*.rar
*.7z
*.sh
# Scripts in tools/ are part of the project and must ship. The comment has to
# live on its own line: git treats a trailing '#' as part of the pattern, so
# the negation silently matched nothing and tools/*.sh stayed ignored.
!tools/*.sh

# Python
bot.py
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# AI context — local only
CLAUDE.md
TASKS.md
ASSESSMENT.md
AUDIT.md
.claude/

# Local dev fixture (server_cfg.ini copy + scratch DB + logs)
local-cfg/