# Web server
HOST=0.0.0.0       # 0.0.0.0 = all interfaces, 127.0.0.1 = localhost only
PORT=3000

# AC Server — adjust to your installation paths
AC_SERVER_LOG=/home/YOUR_USER/ac_server/server_output.log
AC_SERVER_RESULTS=/home/YOUR_USER/ac_server/results
AC_CFG_DIR=/srv/assetto/cfg
AC_CONTENT_DIR=/srv/assetto/content
AC_SERVER_BIN=/home/YOUR_USER/ac_server/acServer
AC_SERVER_DIR=/home/YOUR_USER/ac_server
AC_HTTP_PORT=8081       # AC server HTTP API port (used to detect if server is running)

# Optional: path to blacklist file (defaults to <AC_SERVER_DIR>/blacklist.txt)
# AC_BLACKLIST_FILE=/home/YOUR_USER/ac_server/blacklist.txt

# Optional: set a secret token to protect server start/stop/restart/reload endpoints.
# If set, the dashboard injects it automatically — no manual config needed in the browser.
# ADMIN_TOKEN=change-me-to-a-random-secret
