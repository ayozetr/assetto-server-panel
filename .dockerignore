# Mirror of .gitignore + a few build-only exclusions. Keeps the docker
# build context small (faster builds, less data shipped to the daemon).

# Dependencies — installed fresh inside the builder layer
node_modules

# Build artefacts — regenerated by build.js inside the image
dist

# Environment + local state — never ship into the image; docker-compose
# mounts real config at runtime
.env
.env.*
local-cfg
*.db
*.db-shm
*.db-wal
logs
*.log
*.txt
*.zip
*.rar
*.7z

# AI / scratch
.claude
CLAUDE.md
TASKS.md
ASSESSMENT.md

# VCS
.git
.gitignore
.github

# OS / editor
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo
