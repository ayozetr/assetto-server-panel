# =============================================================================
# Assetto Server Dashboard — environment variables
# =============================================================================
# Copy this file to `.env` and adjust the paths to match your installation.
# Anything left commented uses a sensible default (see comments below).

# ── Web server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0       # 0.0.0.0 = listen on all interfaces, 127.0.0.1 = localhost only
PORT=3000          # panel port

# ── AC Server paths ──────────────────────────────────────────────────────────
# Two layouts are common:
#   (a) everything under the user's home: /home/<user>/ac_server/{cfg,content,...}
#   (b) shared system path:               /srv/assetto/{cfg,content} + binary in $HOME
# Pick whichever matches your install — the panel doesn't care, as long as the
# four AC_* paths below point at the actual directories.
AC_SERVER_RESULTS=/home/YOUR_USER/ac_server/results
AC_CFG_DIR=/home/YOUR_USER/ac_server/cfg
AC_CONTENT_DIR=/home/YOUR_USER/ac_server/content
AC_SERVER_BIN=/home/YOUR_USER/ac_server/acServer
AC_SERVER_DIR=/home/YOUR_USER/ac_server

# AC server HTTP API port. Must match HTTP_PORT in server_cfg.ini — the panel
# polls /INFO here to detect whether acServer is running and to bootstrap
# session state.
AC_HTTP_PORT=8081

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# AC_SERVER_LOG=./logs/ac_server.log   # default: created automatically inside the project
# AC_BLACKLIST_FILE=/home/YOUR_USER/ac_server/blacklist.txt
# AC_WHITELIST_FILE=/srv/assetto/cfg/whitelist.txt
# DB_PATH=/home/YOUR_USER/assetto-dashboard/assetto.db

# Optional: force the public IP shown in the "Connect" button instead of
# auto-detecting it via outbound network. Useful behind NAT or a tunnel.
# PUBLIC_IP=1.2.3.4

# ── Headless / proxy access ──────────────────────────────────────────────────
# Optional: legacy static token to protect server control endpoints
# (start/stop/restart/reload). Session cookies are the preferred auth mechanism —
# only set this for scripts that can't go through the login flow.
# ADMIN_TOKEN=change-me-to-a-random-secret

# Set to 1 only when the panel is reachable EXCLUSIVELY through a reverse proxy
# (Cloudflare Tunnel, nginx, etc). Honours CF-Connecting-IP / X-Forwarded-For so
# rate limits and audit logs see the real client. Leave unset / 0 if the panel is
# also reachable directly — otherwise clients can spoof these headers.
# TRUST_PROXY=1

# ── Retention ────────────────────────────────────────────────────────────────
# How many days of audit_log entries to keep. Default 365. A daily sweeper
# deletes older rows so the table doesn't grow unbounded.
# AUDIT_RETENTION_DAYS=365

# How many timestamped server_cfg.ini.<datetime>.bak copies to keep. Default 10.
# The plain server_cfg.ini.bak (last save) is always kept on top.
# CFG_BACKUPS_KEEP=10

# ── Things you do NOT need to set ────────────────────────────────────────────
# UDP plugin (live lap capture): the panel writes UDP_PLUGIN_LOCAL_PORT and
# UDP_PLUGIN_ADDRESS into server_cfg.ini on the first session apply, picks a
# default port pair (12000 / 127.0.0.1:12001), restarts acServer to pick it up
# and starts streaming events. Zero manual config.
