# Web server
HOST=0.0.0.0       # 0.0.0.0 = all interfaces, 127.0.0.1 = localhost only
PORT=3000

# AC Server — adjust to your installation paths
AC_SERVER_RESULTS=/home/YOUR_USER/ac_server/results
AC_CFG_DIR=/srv/assetto/cfg
AC_CONTENT_DIR=/srv/assetto/content
AC_SERVER_BIN=/home/YOUR_USER/ac_server/acServer
AC_SERVER_DIR=/home/YOUR_USER/ac_server
AC_HTTP_PORT=8081       # AC server HTTP API port (used to detect if server is running)

# Optional: override default file paths (defaults shown)
# AC_SERVER_LOG=./logs/ac_server.log   # default: created automatically inside the project
# AC_BLACKLIST_FILE=/home/YOUR_USER/ac_server/blacklist.txt
# AC_WHITELIST_FILE=/srv/assetto/cfg/whitelist.txt
# DB_PATH=/home/YOUR_USER/assetto-dashboard/assetto.db

# Optional: legacy static token to protect server control endpoints (start/stop/restart/reload).
# Session cookies are the preferred auth mechanism — only set this for headless/script access.
# ADMIN_TOKEN=change-me-to-a-random-secret

# Set to 1 only when the panel is reachable EXCLUSIVELY through a reverse proxy
# (Cloudflare Tunnel, nginx, etc). Honours CF-Connecting-IP / X-Forwarded-For so
# rate limits and audit logs see the real client. Leave unset / 0 if the panel is
# also reachable directly — otherwise clients can spoof these headers.
# TRUST_PROXY=1
